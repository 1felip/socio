{
  "name": "socio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node scripts/vitest.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "eval:quick": "node -e \"console.log('eval:quick: nenhuma suíte ainda (placeholder)')\"",
    "db:types": "supabase gen types typescript --linked --schema public > packages/db/src/database.types.ts",
    "seed": "pnpm --filter seed seed"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "26.6.6",
    "promptfoo": "0.125.1",
    "supabase": "3.0.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
