{
  "name": "socio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node scripts/vitest.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "eval:quick": "pnpm eval:injection && pnpm --filter @socio/agents eval:menu --quick",
    "db:types": "supabase gen types typescript --linked --schema public > packages/db/src/database.types.ts",
    "seed": "pnpm --filter seed seed",
    "llm:smoke": "pnpm --filter @socio/llm smoke",
    "eval:reviews": "pnpm --filter @socio/agents eval:reviews",
    "eval:analyst": "pnpm --filter @socio/agents eval:analyst",
    "eval:menu": "pnpm --filter @socio/agents eval:menu",
    "eval:injection": "pnpm --filter @socio/agents eval:injection",
    "eval:table": "node scripts/eval-table.mjs",
    "menu:gold": "pnpm --filter @socio/agents menu:gold"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "26.6.6",
    "promptfoo": "0.125.1",
    "supabase": "3.0.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
