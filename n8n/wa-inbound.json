{
  "name": "wa-inbound",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "socio-wa",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Meta verifica (GET)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "socio-wa-get"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SOCIO_API_URL }}/api/whatsapp/inbound",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "hub.mode", "value": "={{ $json.query['hub.mode'] }}" },
            { "name": "hub.verify_token", "value": "={{ $json.query['hub.verify_token'] }}" },
            { "name": "hub.challenge", "value": "={{ $json.query['hub.challenge'] }}" }
          ]
        },
        "options": {
          "response": {
            "response": { "fullResponse": true, "neverError": true, "responseFormat": "text" }
          }
        }
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000002",
      "name": "API confere o token",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.data }}",
        "options": { "responseCode": "={{ $json.statusCode }}" }
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000003",
      "name": "Devolve o challenge",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [440, 0]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "socio-wa",
        "responseMode": "onReceived",
        "responseCode": 200,
        "options": { "rawBody": true }
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000004",
      "name": "Meta manda mensagem (POST)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 240],
      "webhookId": "socio-wa-post"
    },
    {
      "parameters": {
        "jsCode": "// Repassa o corpo CRU da Meta (a assinatura dela é sobre esses bytes) e assina com o HMAC do n8n.\n// Requer NODE_FUNCTION_ALLOW_BUILTIN=crypto e N8N_WEBHOOK_SECRET no ambiente do n8n.\nconst crypto = require('crypto');\nconst buf = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst raw = buf.toString('utf8');\nconst ts = String(Math.floor(Date.now() / 1000));\nconst sig = crypto.createHmac('sha256', $env.N8N_WEBHOOK_SECRET).update(`${ts}.${raw}`).digest('hex');\nconst meta = $input.first().json.headers['x-hub-signature-256'] ?? '';\nreturn [{ json: { raw, ts, sig, meta } }];"
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000005",
      "name": "Assina corpo cru",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 240]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SOCIO_API_URL }}/api/whatsapp/inbound",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-hub-signature-256", "value": "={{ $json.meta }}" },
            { "name": "x-socio-timestamp", "value": "={{ $json.ts }}" },
            { "name": "x-socio-signature", "value": "={{ $json.sig }}" }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.raw }}",
        "options": { "timeout": 60000 }
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000006",
      "name": "API decide a resposta",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 240],
      "retryOnFail": false
    },
    {
      "parameters": {
        "fieldToSplitOut": "replies",
        "options": {}
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000007",
      "name": "Uma resposta por item",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [660, 240]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "mode": "list",
          "value": "wa-buttons",
          "cachedResultName": "wa-buttons"
        },
        "mode": "each",
        "options": { "waitForSubWorkflow": true }
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000008",
      "name": "Envia (wa-buttons)",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [880, 240]
    }
  ],
  "connections": {
    "Meta verifica (GET)": {
